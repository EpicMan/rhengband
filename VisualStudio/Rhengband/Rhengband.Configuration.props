<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <RhengbandDebugBuild Condition="$(Configuration.EndsWith('Debug'))">true</RhengbandDebugBuild>
    <RhengbandJapanese Condition="!$(Configuration.StartsWith('English'))">true</RhengbandJapanese>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization Condition="'$(RhengbandDebugBuild)'!='true'">true</WholeProgramOptimization>
    <UseDebugLibraries Condition="'$(RhengbandDebugBuild)'=='true'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(RhengbandDebugBuild)'!='true'">false</UseDebugLibraries>
  </PropertyGroup>
</Project>
